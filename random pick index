import random

class Solution(object):

    def __init__(self, nums):
        """
        :type nums: List[int]
        """
        self.nums = nums

    def pick(self, target):
        """
        :type target: int
        :rtype: int
        """
        indices = []

        for i, num in enumerate(self.nums):
            if num == target:
                indices.append(i)

        return random.choice(indices)
